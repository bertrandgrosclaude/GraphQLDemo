<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Serveur GraphQL pour ASP.NET Core -->
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.4" />
    <!-- Intégration EF Core avec HotChocolate (pour la pagination/tri/filtrage sur les DbSet) -->
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.6.4" />
    <!-- Directive @authorize / attribut [Authorize] pour protéger les champs GraphQL -->
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.6.4" />
    <!-- Authentification par jeton JWT (Bearer) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <!-- EF Core + provider SQLite (facile à démarrer, pas besoin de serveur SQL) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

  </ItemGroup>

</Project>
